rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "6sT3J0gEATNU1qTKbfjWPFVEWXC3";
    }

    function pageIsPublic(section) {
      return (
        section == "story"
        && exists(/databases/$(database)/documents/pages/story)
        && get(/databases/$(database)/documents/pages/story).data.status == "public"
      ) || (
        section == "character"
        && exists(/databases/$(database)/documents/pages/character)
        && get(/databases/$(database)/documents/pages/character).data.status == "public"
      ) || (
        section == "archive"
        && exists(/databases/$(database)/documents/pages/archive)
        && get(/databases/$(database)/documents/pages/archive).data.status == "public"
      );
    }

    // 페이지 제목/잠금 상태는 일반 주소에서도 확인할 수 있어야 한다.
    // 실제 콘텐츠 권한은 아래 규칙에서 별도로 검사한다.
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 페이지가 공개 상태이고 문서 자체도 공개인 경우에만 일반 방문자가 읽을 수 있다.
    match /content/{contentId} {
      allow read: if isAdmin()
        || (resource.data.status == "public" && pageIsPublic(resource.data.section));
      allow write: if isAdmin();
    }

    // 인물 프로필은 '인물' 페이지가 공개일 때만 일반 방문자가 읽을 수 있다.
    match /characterPairs/{pairId} {
      allow read: if isAdmin() || pageIsPublic("character");
      allow write: if isAdmin();
    }

    // 그 밖의 문서는 계속 관리자 전용이다.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
